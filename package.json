{
  "name": "solarimsys",
  "version": "0.0.78",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git@github.com:miklosherald09/solar-installation-management-system.git"
  },
  "scripts": {
    "android": "scripts\\run-android.cmd",
    "avd": "\"%ANDROID_HOME%\\emulator\\emulator\" -avd Pixel_9_Pro",
    "avd:list": "\"%ANDROID_HOME%\\emulator\\emulator\" -list-avds",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "format": "prettier --write \"src\" \"App.tsx\" \"index.js\" \"__tests__\" \"babel.config.js\" \"metro.config.js\" \"tailwind.config.js\" \"jest.config.js\"",
    "start": "react-native start",
    "start:clean": "react-native start --reset-cache",
    "test": "jest",
    "emulator": "emulator -avd Pixel_9_Pro",
    "bump": "npm version patch --no-git-tag-version && git add . && git push",
    "bump:ios": "node scripts/bump-ios-version.js",
    "tag": "npm version patch && git add . && git push",
    "codepush:android": "npx code-push release -b 1.0.0 -p android -i staging -e index.js",
    "codepush:ios": "npx code-push release -b 1.0.0 -p ios -i staging -e index.js",
    "codepush:create-history": "npx code-push create-history --binary-version 1.0.0 --platform ios --identifier staging",
    "codepush:show-history": "npx code-push show-history --binary-version 1.0.0 --platform ios --identifier staging"
  },
  "dependencies": {
    "@bravemobile/react-native-code-push": "^13.0.0",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@invertase/react-native-apple-authentication": "^2.5.1",
    "@miblanchard/react-native-slider": "^2.6.0",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-native-community/datetimepicker": "^9.1.0",
    "@react-native-community/geolocation": "^3.4.0",
    "@react-native-community/slider": "^5.2.0",
    "@react-native-firebase/app": "^21.0.0",
    "@react-native-firebase/messaging": "^21.0.0",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@react-native/new-app-screen": "0.86.0",
    "@react-navigation/bottom-tabs": "^7.18.11",
    "@react-navigation/native": "^7.3.11",
    "@react-navigation/native-stack": "^7.18.3",
    "@tanstack/query-async-storage-persister": "^5.102.8",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-query-persist-client": "^5.102.8",
    "cline": "^3.0.46",
    "clsx": "^2.1.1",
    "libphonenumber-js": "^1.13.11",
    "minio": "^8.0.7",
    "nativewind": "^4.2.6",
    "react": "19.2.3",
    "react-hook-form": "^7.82.0",
    "react-native": "0.86.0",
    "react-native-callkeep": "^4.3.16",
    "react-native-gesture-handler": "^3.1.0",
    "react-native-image-picker": "^8.2.1",
    "react-native-incall-manager": "^4.2.2",
    "react-native-keychain": "^10.0.0",
    "react-native-maps": "^1.29.0",
    "react-native-paper": "^5.15.3",
    "react-native-reanimated": "^4.5.3",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-screens": "^4.26.2",
    "react-native-sound": "^0.13.0",
    "react-native-vector-icons": "^10.3.0",
    "react-native-voip-push-notification": "^3.3.3",
    "react-native-webrtc": "^124.0.8",
    "react-native-worklets": "0.11.1",
    "sip.js": "^0.21.2",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^3.4.19",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.1.0",
    "@react-native-community/cli-platform-android": "20.1.0",
    "@react-native-community/cli-platform-ios": "20.1.0",
    "@react-native/babel-preset": "0.86.0",
    "@react-native/eslint-config": "0.86.0",
    "@react-native/jest-preset": "^0.86.0",
    "@react-native/metro-config": "0.86.0",
    "@react-native/typescript-config": "0.86.0",
    "@types/jest": "^29.5.13",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}

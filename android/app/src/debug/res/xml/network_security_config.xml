<?xml version="1.0" encoding="utf-8"?>
<!-- Debug-only override: allow cleartext (HTTP) so Metro can serve the JS bundle.
     The main (release) config remains locked down to the backend IPs only. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
